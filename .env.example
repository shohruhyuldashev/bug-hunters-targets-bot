# Run `python scripts/bootstrap.py` to create a real .env with strong secrets.
APP_ENV=development
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-start
JWT_SECRET=replace-with-a-long-random-value
ENCRYPTION_KEY=replace-with-a-fernet-key

# data/db.sqlite3 is relative to the project directory.
DATABASE_PATH=data/db.sqlite3
JWT_EXPIRE_MINUTES=720
SCAN_TICK_SECONDS=30
REQUEST_TIMEOUT_SECONDS=20
NOTIFY_EXISTING_ON_FIRST_SYNC=false
ALLOW_INSECURE_ENDPOINTS=false
LOCAL_WEB_ONLY=true
WEB_SETUP_EXPIRE_SECONDS=600

# Required for the shared Telegram bot. It is never sent to clients.
TELEGRAM_BOT_TOKEN=

# The Telegram Mini App must be public HTTPS so clients can open it. Expose only
# /miniapp and /relay through a reverse proxy; keep the owner console local.
MINI_APP_URL=https://monitor.example.com/miniapp/
RELAY_PUBLIC_URL=https://monitor.example.com/relay

# Centralized HackerOne Monitor Config
H1_GLOBAL_IDENTIFIER=
H1_GLOBAL_TOKEN=
